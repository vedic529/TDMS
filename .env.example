# ---------------------------------------------------------------------------
# TDMS - repository level example environment file
# ---------------------------------------------------------------------------
# This file documents the variables used by docker compose when the frontend
# and backend are started together. Copy it to `.env` and adjust locally.
#
# Never commit a real `.env` file. Never place a Microsoft client secret or a
# production database connection string in this repository.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Ports exposed by docker compose
WEB_PORT=3000
API_PORT=8000

# ---------------------------------------------------------------------------
# Local PostgreSQL development database (docker compose service `db`)
# ---------------------------------------------------------------------------
# DEVELOPMENT ONLY. This is never staging, never production and never Supabase.
# The database name deliberately carries the `_dev` suffix.
#
# Copy this file to `.env` and set TDMS_POSTGRES_ADMIN_PASSWORD to a local
# value. Compose fails with a clear message if it is missing, rather than
# starting the database with a blank password.
#
# `.env` is ignored by Git. Never put a real password in this example file.

TDMS_POSTGRES_DB=tdms_dev
TDMS_POSTGRES_ADMIN_USER=postgres
TDMS_POSTGRES_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Least-privilege application database identity
# ---------------------------------------------------------------------------
# FastAPI connects as this role; migrations keep using the admin credentials
# above. `tdms_app` cannot create, alter or drop anything, and cannot UPDATE or
# DELETE user activity records — LOG-05 becomes a privilege rather than a
# convention. Create it with database/roles/create-application-role.sql.
#
# If left blank the application falls back to the admin credentials, which works
# but gives up the protection. `GET /auth/configuration` and the backend tests
# report which identity is actually in use.
TDMS_POSTGRES_APP_USER=tdms_app
TDMS_POSTGRES_APP_PASSWORD=
# Host port only. The container always listens on 5432 internally.
# Change this if 5432 is already taken on your machine (e.g. 5433).
TDMS_POSTGRES_PORT=5432

# Base URL the browser uses to reach the TDMS API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend data mode: `mock` uses MockTdmsClient, `api` uses ApiTdmsClient.
NEXT_PUBLIC_TDMS_DATA_MODE=mock

# Frontend authentication mode: `mock` or `entra`.
NEXT_PUBLIC_TDMS_AUTH_MODE=mock

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Step 5)
# ---------------------------------------------------------------------------
# mock  -> development sign-in adapter. Refused when APP_ENV=production.
# entra -> real Microsoft sign-in. Requires the two values below.
TDMS_AUTH_MODE=mock

# The Application (Client) ID of the approved TDMS app registration.
# A public identifier, not a secret - it appears in every authorisation URL.
ENTRA_CLIENT_ID=

# Comma-separated tenant IDs permitted to reach TDMS. THIS is the security
# boundary: an email suffix is not one, because anybody can create a lookalike
# mailbox in a tenant they control. Personal Microsoft accounts are refused
# regardless of what is listed here.
ENTRA_ALLOWED_TENANT_IDS=

# The delegated scope an incoming access token must carry, e.g.
# `access_as_user`. Checking it stops a token minted for a different API in the
# same tenant being replayed against TDMS. Blank until the API app registration
# exposes a scope; the audience check still applies.
ENTRA_API_SCOPE=

ENTRA_REDIRECT_URI=http://localhost:3000/login

# Confirmed inactivity timeout (OD-03).
TDMS_SESSION_INACTIVITY_MINUTES=30

# ---------------------------------------------------------------------------
# Access request notifications
# ---------------------------------------------------------------------------
# development -> records the notification locally and reports that nothing was
#                sent. graph -> sends through Microsoft Graph Mail.Send.
TDMS_NOTIFICATION_MODE=development

# Needed only when TDMS_NOTIFICATION_MODE=graph. GRAPH_CLIENT_SECRET is a real
# secret: keep it in this ignored .env file, never in .env.example, and never
# in any NEXT_PUBLIC_ variable.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Where an emailed link points. Not a security boundary: the link opens TDMS,
# which authenticates the approver normally.
TDMS_APP_BASE_URL=http://localhost:3000
