# ---------------------------------------------------------------------------
# TDMS - repository level example environment file
# ---------------------------------------------------------------------------
# This file documents the variables used by docker compose when the frontend
# and backend are started together. Copy it to `.env` and adjust locally.
#
# Never commit a real `.env` file. Never place a Microsoft client secret or a
# production database connection string in this repository.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Ports exposed by docker compose
WEB_PORT=3000
API_PORT=8000

# Base URL the browser uses to reach the TDMS API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend data mode: `mock` uses MockTdmsClient, `api` uses ApiTdmsClient.
NEXT_PUBLIC_TDMS_DATA_MODE=mock

# Frontend authentication mode: `mock` or `entra`.
NEXT_PUBLIC_TDMS_AUTH_MODE=mock
