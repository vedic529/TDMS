# ---------------------------------------------------------------------------
# TDMS - Timetable Database Management System
# ---------------------------------------------------------------------------

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
.next/
out/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Environment / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
secrets/

# Build output
dist/
build/
coverage/

# Local prototype databases (never production data)
*.sqlite
*.sqlite3
*.db

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Machine-specific local tooling config
.claude/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Real operational source data
# ---------------------------------------------------------------------------
# The approved workbooks live in the repository so every script resolves one
# stable path, but they are NEVER committed: they carry student, staff and
# college records, and this repository is public.
#
# Only the README that explains what belongs here is tracked.
data/source/*
!data/source/README.md

# Student files, wherever they land. These are the highest-risk artefacts in
# the project, so the rule is by shape rather than by folder.
*Student_List*
*Student List*
*Master List*
*student list*

# Archives of the working tree. `.claude/` is ignored but `.claude.zip` was not,
# and one such archive carried .env, apps/web/.env.local, node_modules and .venv
# — 266 MB including live database passwords. Ignore the shape, not one name.
*.zip
!docs/**/*.zip

# ---------------------------------------------------------------------------
# Explicitly tracked (do not ignore)
# ---------------------------------------------------------------------------
!.env.example
!apps/web/.env.example
!apps/api/.env.example
!apps/web/package-lock.json
!apps/api/requirements.txt
!**/Dockerfile
!docker-compose.yml
