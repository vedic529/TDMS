# ---------------------------------------------------------------------------
# TDMS frontend environment example
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. `.env.local` is ignored by Git.
# Never place a Microsoft client secret in a NEXT_PUBLIC_ variable: every
# NEXT_PUBLIC_ value is embedded in the browser bundle.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=TDMS

# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Base URL of the TDMS FastAPI service. Used by ApiTdmsClient.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# mock -> MockTdmsClient (demo data held in prototype browser storage)
# api  -> ApiTdmsClient  (future FastAPI service)
NEXT_PUBLIC_TDMS_DATA_MODE=mock

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# mock  -> MockAuthProvider (demo session, no Microsoft call is made)
# entra -> MicrosoftEntraAuthProvider (requires the values below)
NEXT_PUBLIC_TDMS_AUTH_MODE=mock

# Supplied by the organisation once OD-01 (Microsoft Entra configuration) is
# approved. Leave blank while the tenant is not configured: the sign-in button
# then falls back to the mock provider automatically.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000/login

# ---------------------------------------------------------------------------
# Development-only tools
# ---------------------------------------------------------------------------
# Enables the discreet development access-preview panel used to check the
# permission behaviour of each access level while Microsoft Entra ID and the
# backend are not connected. Must be false for staging and production.
NEXT_PUBLIC_TDMS_DEV_TOOLS=true
