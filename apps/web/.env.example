# ---------------------------------------------------------------------------
# TDMS frontend environment example
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. `.env.local` is ignored by Git.
# Never place a Microsoft client secret in a NEXT_PUBLIC_ variable: every
# NEXT_PUBLIC_ value is embedded in the browser bundle.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=TDMS

# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Base URL of the TDMS FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Supplied by IT from the approved TDMS application registration. Both are
# public identifiers - they appear in every authorisation URL. A client SECRET
# is confidential and must never be a NEXT_PUBLIC_ value.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
# Comma-separated tenant IDs permitted to reach TDMS.
NEXT_PUBLIC_ENTRA_ALLOWED_TENANT_IDS=
# The full delegated scope the browser requests, so the token it receives is
# intended for the TDMS API - e.g. api://<api-client-id>/access_as_user.
NEXT_PUBLIC_ENTRA_API_SCOPE=
# Optional. Defaults to the first allowed tenant.
NEXT_PUBLIC_ENTRA_AUTHORITY=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000/login

# Sign-in is disabled until the Entra values above are supplied.
