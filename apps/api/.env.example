# ---------------------------------------------------------------------------
# TDMS API environment example
# ---------------------------------------------------------------------------
# Copy to `.env` for local development. `.env` is ignored by Git.
# Never commit a real connection string, client secret or tenant identifier.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Optional. Leave blank for normal local development: `app.core.config` composes
# the URL from the TDMS_POSTGRES_* variables in the repository-root `.env`, which
# is where the local password lives. Set this only to point at a different
# database, and never commit a value.
#
# Format:
#   postgresql+psycopg://<user>:<password>@localhost:5432/tdms_dev
#
# Still outstanding:
#   * migrations currently run as the `postgres` superuser; a least-privilege
#     application role for runtime access has not been created yet;
#   * DATA-07 / OD-13 require approval before any production or Supabase
#     connection string is used here.
DATABASE_URL=

# Microsoft Entra ID. The API reads these from the repository-root .env in
# local development; set them here to override for the backend alone.
#
#   TDMS_AUTH_MODE                mock | entra  (mock is refused in production)
#   ENTRA_CLIENT_ID               audience the API accepts tokens for
#   ENTRA_ALLOWED_TENANT_IDS      comma-separated; the real security boundary
#   ENTRA_API_SCOPE               delegated scope a token must carry
#   ENTRA_REDIRECT_URI            approved redirect address
TDMS_AUTH_MODE=
ENTRA_CLIENT_ID=
ENTRA_ALLOWED_TENANT_IDS=
ENTRA_API_SCOPE=
ENTRA_REDIRECT_URI=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
