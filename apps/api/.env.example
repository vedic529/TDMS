# ---------------------------------------------------------------------------
# TDMS API environment example
# ---------------------------------------------------------------------------
# Copy to `.env` for local development. `.env` is ignored by Git.
# Never commit a real connection string, client secret or tenant identifier.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Left blank on purpose. DATA-07 / OD-13 require the final PostgreSQL schema
# and hosting configuration to be approved before a production database is
# connected. Supabase is not connected yet.
DATABASE_URL=

# Supplied once OD-01 (Microsoft Entra configuration) is approved.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
